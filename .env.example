# Variables for docker-compose.qlane.yml. Set each on the Qlane test target; the stack
# refuses to start while any of them is empty.

# Rails' secret_key_base, 64 or more characters.
SECRET_KEY_BASE=
# The password of the QA login (qatester, not an admin), 5 to 72 characters.
QA_PASSWORD=
# The password of the admin login (admin), 5 to 72 characters.
ADMIN_PASSWORD=
